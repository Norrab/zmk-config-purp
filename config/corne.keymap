#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10    // default: 10

#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
};

/ {
        keymap {
                compatible = "zmk,keymap";

                BASE {
// -----------------------------------------------------------------------------------------
// | ESC |  Q  |  W  |  E  |  R  |  T   |      |  Y  |  U  |  I  |  O  |  P  |     |
// | TAB |  A  |  S  |  D  |  F  |  G   |      |  H  |  J  |  K  |  L  |  '  | DEL |
// |     |  Z  |  X  |  C  |  V  |  B   |      |  N  |  M  |  ,  |  .  |  /  |     |
//                   | NUM | SPC | BSPC |      | ENT | SYM | NAV |
                        bindings = <
   &kp ESC   &kp Q       &kp W      &kp E       &kp R       &kp T     &kp Y   &kp U       &kp I       &kp O      &kp P        &none
   &kp TAB   &mt LGUI A  &mt LALT S &mt LCTRL D &mt LSHFT F &kp G     &kp H   &mt RSHFT J &mt RCTRL K &mt RALT L &mt RGUI SQT &kp DEL
   &none     &kp Z       &kp X      &kp C       &kp V       &kp B     &kp N   &kp M       &kp COMMA   &kp DOT    &kp FSLH     &none
                                    &mo 2       &kp SPACE   &kp BSPC  &kp RET &mo 1       &mo 3
                        >;
                };
                SYM {
// -----------------------------------------------------------------------------------------
// |    |  !  |  @  |  #  |  $  |  %  |      |  ^  |  &  |  *  |  ?  | "|" |    |
// |    |  /  |  {  |  }  |  "  |  -  |      |  +  |  '  |  (  |  )  |  ;  |    |
// |    |  \  |  [  |  ]  |  _  |  `  |      |  ~  |  =  |  <  |  >  |  :  |    |
//            |     |     |     |     |      |     |     |
                        bindings = <
   &trans &kp EXCL &kp AT   &kp HASH &kp DLLR  &kp PERCENT     &kp CARET &kp AMPS  &kp ASTRK &kp QMARK &kp PIPE  &trans
   &trans &kp FSLH &kp LBRC &kp RBRC &kp DQT   &kp MINUS       &kp PLUS  &kp SQT   &kp LPAR  &kp RPAR  &kp SEMI  &trans
   &trans &kp BSLH &kp LBKT &kp RBKT &kp UNDER &kp GRAVE       &kp TILDE &kp EQUAL &kp LT    &kp GT    &kp COLON &trans
                            &trans   &trans    &trans          &trans    &trans    &trans
                        >;
                };
                NUM {
// -----------------------------------------------------------------------------------------
// | BT UP |  F1 |  F2 |  F3 |  F4 |  F5 |      |   |  7  |  8  |  9  |  *  |     |
// | BT DN |  F6 |  F7 |  F8 |  F9 | F10 |      |   |  4  |  5  |  6  |  +  |  -  |
// | BT CLR| F11 | F12 |     |     |     |      |   |  1  |  2  |  3  |  /  |     |
//                     |     |     |     |      |   |  0  |  .  |
                        bindings = <
   &bt BT_NXT &kp F1  &kp F2  &kp F3 &kp F4 &kp F5     &trans &kp N7 &kp N8 &kp N9 &kp ASTRK &trans
   &bt BT_PRV &kp F6  &kp F7  &kp F8 &kp F9 &kp F10    &trans &kp N4 &kp N5 &kp N6 &kp PLUS  &kp MINUS
   &bt BT_CLR &kp F11 &kp F12 &trans &trans &trans     &trans &kp N1 &kp N2 &kp N3 &kp FSLH  &trans
                              &trans &trans &trans     &trans &kp N0 &kp DOT
                        >;
                };
                NAV {
// -----------------------------------------------------------------------------------------
// |   |       |  PRVS   |  PLAY  |  NEXT  |         |      |      |  MUTE  | VL DN | VL UP |        |     |
// |   | PG UP | SCRL UP | MSBTN1 | MSBTN2 | MDL CLK |      | HOME |  LEFT  | DOWN  |   UP  | RIGHT  | END |
// |   | PG DN | SCRL DN | MS BCK | MS FRWD|         |      |      | MS LFT | MS DN | MS UP | MS RGT |     |
//                       |        |        |         |      |      |        |       |
                        bindings = <
   &trans &trans    &kp K_PREV     &kp K_PP   &kp K_NEXT &trans     &trans   &kp K_MUTE     &kp K_VOL_DN   &kp K_VOL_UP &trans          &trans
   &trans &kp PG_UP &msc SCRL_UP   &mkp MB1   &mkp MB2   &mkp MB3   &kp HOME &kp LEFT       &kp DOWN       &kp UP       &kp RIGHT       &kp END
   &trans &kp PG_DN &msc SCRL_DOWN &mkp MB4   &mkp MB5   &trans     &trans   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &trans
                                   &trans     &trans     &trans     &trans   &trans         &trans
                        >;
                };
                GAME {
// -----------------------------------------------------------------------------------------
// | TAB  |  Q  |  W  |  E  |  R  |  T   |      |  Y  |  U  |  I  |  O  |  P  | ESC |
// | SHFT |  A  |  S  |  D  |  F  |  G   |      |  H  |  J  |  K  |  L  |  '  | DEL |
// | CTRL |  Z  |  X  |  C  |  V  |  B   |      |  N  |  M  |  ,  |  .  |  /  | ALT |
//                    | NUM | SPC | BSPC |      | ENT | SYM | NAV |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R     &kp T     &kp Y   &kp U  &kp I     &kp O   &kp P    &kp ESC
   &kp LSHFT &kp A &kp S &kp D &kp F     &kp G     &kp H   &kp J  &kp K     &kp L   &kp SQT  &kp DEL
   &kp LCTRL &kp Z &kp X &kp C &kp V     &kp B     &kp N   &kp M  &kp COMMA &kp DOT &kp FSLH &kp LALT
                         &mo 2 &kp SPACE &kp BSPC  &kp RET &mo 1  &mo 3
                        >;
                };
        };
};
